<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<application
    android:name=".TrailMateApplication"
        android:label="TrailMate"
        android:theme="@style/Theme.TrailMate">

        <!-- Login screen (Launcher) -->
        <activity
            android:name="com.trailmate.app.ui.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main screen -->
        <activity
            android:name="com.trailmate.app.MainActivity" />

    </application>

</manifest>
